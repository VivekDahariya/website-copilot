# Website CoPilot settings. Every line below is optional: the value shown is the default.
# Use it with:  cp .env.example .env   then   node --env-file=.env src/ui/server.js   (Node 20.6+)
# This file holds no secrets. Never put passwords or tokens in it.

# Dashboard
PORT=4317
COPILOT_BIND_HOST=127.0.0.1

# Local models (pull them first: ollama pull qwen3:4b && ollama pull qwen2.5:3b)
COPILOT_OLLAMA_URL=http://127.0.0.1:11434/api/chat
COPILOT_OLLAMA_MODEL=qwen3:4b
COPILOT_READING_MODEL=qwen2.5:3b

# Browser window: 1 = no window at all; 0 = normal minimised window instead of a hidden launch
# COPILOT_HEADLESS=1
# COPILOT_HIDDEN_LAUNCH=0

# Maximum actions per run (1 to 50)
COPILOT_MAX_STEPS=12
